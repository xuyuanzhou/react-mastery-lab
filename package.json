{
  "name": "react-mastery-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/index.mjs && vite --host 0.0.0.0 --force --port 5173 --strictPort",
    "build": "node scripts/index.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "import": "node scripts/import.mjs",
    "index": "node scripts/index.mjs",
    "chapter:new": "node scripts/create-chapter.mjs",
    "chapter:validate": "node scripts/validate-content.mjs",
    "test": "node --test scripts/*.test.mjs mini-react/test/*.test.mjs && vitest run",
    "mini:demo": "node mini-react/demo.mjs",
    "mini:test": "node --test mini-react/test/*.test.mjs",
    "sync-source": "node scripts/sync-source.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts mini-react vite.config.ts vitest.config.ts eslint.config.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"mini-react/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"mini-react/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "check": "npm run format:check && npm run lint && npm run chapter:validate && npm test && npm run build",
    "pretest": "npm run index"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.6",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
